def reach_report(host, port):
    """Достаёт ли этот сервер до host:port. Отказ в соединении — тоже связь: порт просто закрыт."""
    try:
        with socket.create_connection((host, port), timeout=5):
            tcp = "open"
    except ConnectionRefusedError:
        tcp = "refused"
    except socket.timeout:
        tcp = "timeout"
    except OSError as e:
        tcp = "error: " + (e.strerror or e.__class__.__name__)
    icmp = run_text("ping", "-c", "2", "-W", "2", host) is not None
    ok = tcp in ("open", "refused")
    if ok:
        msg = "связь есть"
    elif icmp:
        # Чья сторона режет, отсюда не видно: так ведёт себя и фильтр исходящего трафика
        # у хостера этого сервера, и фильтр входящего у хостера адреса.
        msg = ("пинг проходит, а TCP-соединения нет: соединения режет хостер одного из серверов "
               "или сеть между ними. Связать эти два сервера не получится")
    else:
        msg = "нет ни TCP-соединения, ни пинга: адрес недоступен, выключен или закрыт файрволом"
    return {"host": host, "port": port, "tcp": tcp, "icmp": icmp, "ok": ok, "message": msg}


def cmd_reach(a):
    args = [x for x in a if x != "--json"]
    if len(args) != 2 or not args[1].isdigit() or not 1 <= int(args[1]) <= 65535:
        die("используйте: exitctl reach <адрес> <порт> [--json]")
    if not re.fullmatch(r"[A-Za-z0-9.:-]+", args[0]):
        die(f"неверный адрес {args[0]}")
    rep = reach_report(args[0], int(args[1]))
    if "--json" in a:
        print(json.dumps(rep, ensure_ascii=False, indent=2))
    else:
        icmp = "есть" if rep["icmp"] else "нет"
        print(f'{rep["host"]}:{rep["port"]} — {rep["message"]} (TCP: {rep["tcp"]}, пинг: {icmp})')
    if not rep["ok"]:
        sys.exit(1)


MIGRATE_VERSION = 1


def migrate_export():
    """Всё, что нужно перенести на другой мост. Содержит секреты: выводится только в stdout."""
    base, ex = load(BASE), load(EXITS, {"outbounds": []})
    ib = inbound_in(base)
    rs = ib["streamSettings"]["realitySettings"]
    r = find_rule(base, RULE_DIRECT)
    meta = load_meta()
    reconcile(meta, base)
    off = [(m["client"], m["disabled"]) for m in meta["users"].values() if m.get("disabled") and m.get("client")]
    clients = [(c, None) for c in ib["settings"]["clients"]] + off
    return {
        "version": MIGRATE_VERSION,
        "mode": "bridge" if base.get("routing", {}).get("balancers") else "simple",
        "clients": [dict({"id": c["id"], "email": client_name(c), "flow": c.get("flow", "")},
                         **({"disabled": d} if d else {})) for c, d in clients],
        # Сроки, лимиты и накопленный трафик; в старых файлах этого ключа нет.
        "limits": {n: {k: m[k] for k in ("expires", "limit", "used") if m.get(k)}
                   for n, m in meta["users"].items() if any(m.get(k) for k in ("expires", "limit", "used"))},
        "reality": {"privateKey": rs["privateKey"], "shortIds": rs["shortIds"]},
        "direct": list(r["domain"]) if r else [],
        "exits": exits_list(ex),
    }


def migrate_import(data, keys):
    """Добавить пользователей (и на мосту — выходы и сайты напрямую). Существующее не трогается.

    Пользователь пропускается, если такое имя или UUID уже есть: иначе две разные ссылки
    давали бы одно имя в счётчиках или один UUID — двум людям.
    """
    if not isinstance(data, dict) or data.get("version") != MIGRATE_VERSION:
        die("файл переноса не той версии или повреждён")
    base, ex = load(BASE), load(EXITS, {"outbounds": []})
    meta = load_meta()
    reconcile(meta, base)
    ib = inbound_in(base)
    clients = ib["settings"]["clients"]
    off = [m["client"] for m in meta["users"].values() if m.get("disabled") and m.get("client")]
    names = {client_name(c) for c in clients + off}
    ids = {c["id"] for c in clients + off}
    rep = {"added": [], "skipped": [], "keys": False, "direct_added": 0, "exits_added": [], "ignored": []}
    limits = data.get("limits") or {}

    for c in data.get("clients", []):
        name = clean_name(c.get("email", "")) or c["id"][:8]
        if name in names or c["id"] in ids:
            rep["skipped"].append(name)
            continue
        client = {"id": c["id"], "flow": c.get("flow") or "xtls-rprx-vision", "email": name}
        lim = limits.get(name) or {}
        m = {k: lim[k] for k in ("expires", "limit", "used") if isinstance(lim.get(k), (int, float))}
        if c.get("disabled") in LIMIT_REASONS:
            m.update(client=client, disabled=c["disabled"])
        else:
            clients.append(client)
        if m:
            meta["users"][name] = m
        else:
            meta["users"].pop(name, None)
        names.add(name)
        ids.add(c["id"])
        rep["added"].append(name)

    if keys:
        rs = ib["streamSettings"]["realitySettings"]
        rs["privateKey"] = data["reality"]["privateKey"]
        rs["shortIds"] = list(data["reality"]["shortIds"])
        rep["keys"] = True

    is_bridge = bool(base.get("routing", {}).get("balancers"))
    if is_bridge:
        rules = base["routing"]["rules"]
        r = find_rule(base, RULE_DIRECT)
        doms = list(r["domain"]) if r else []
        for d in data.get("direct", []):
            if d not in doms:
                doms.append(d)
                rep["direct_added"] += 1
        if rep["direct_added"]:
            if r:
                rules.remove(r)
            rules.insert(0, {"ruleTag": RULE_DIRECT, "domain": doms, "outboundTag": "direct"})
        tags = {o.get("tag") for o in ex.get("outbounds", [])}
        for o in data.get("exits", []):
            if o.get("tag", "").startswith(PREFIX) and o["tag"] not in tags:
                ex.setdefault("outbounds", []).append(o)
                rep["exits_added"].append(o["tag"][len(PREFIX):])
        if rep["exits_added"]:
            sync_fallback(base, ex)
    else:
        if data.get("direct"):
            rep["ignored"].append("сайты напрямую: на простом сервере всё и так идёт напрямую")
        if data.get("exits"):
            rep["ignored"].append("выходы: простой сервер выходы не использует")

    if rep["added"]:
        save_meta(meta)
    if rep["added"] or rep["keys"] or rep["direct_added"] or rep["exits_added"]:
        apply(base, ex)
    return rep


def cmd_migrate(a):
    if a[:1] == ["export"] and len(a) == 1:
        print(json.dumps(migrate_export(), ensure_ascii=False))
        return
    if a[:1] != ["import"] or len(a) < 2:
        die("используйте: exitctl migrate export | exitctl migrate import <файл> [--keys] [--json]")
    path, opts = a[1], a[2:]
    if any(o not in ("--keys", "--json") for o in opts):
        die("неизвестный параметр: " + " ".join(o for o in opts if o not in ("--keys", "--json")))
    try:
        with open(path) as f:
            data = json.load(f)
    except (OSError, ValueError) as e:
        die(f"не удалось прочитать файл переноса: {e}")
    as_json = "--json" in opts
    with contextlib.redirect_stdout(sys.stderr if as_json else sys.stdout):
        rep = migrate_import(data, "--keys" in opts)
    if as_json:
        print(json.dumps(rep, ensure_ascii=False, indent=2))
        return
    print("Добавлены:", ", ".join(rep["added"]) or "никто")
    if rep["skipped"]:
        print("Пропущены (такое имя или UUID уже есть):", ", ".join(rep["skipped"]))
    if rep["keys"]:
        print("Ключи Reality заменены: прежние ссылки этого сервера больше не работают.")
    if rep["direct_added"] or rep["exits_added"]:
        print(f'Сайтов напрямую добавлено: {rep["direct_added"]}, выходов: {", ".join(rep["exits_added"]) or "нет"}')
    for note in rep["ignored"]:
        print("Не перенесено —", note)


# Команды, которые меняют конфиг или файл ограничений: выполняются по одной (cron и приложение).
LOCKED = {"add", "remove", "use", "auto", "direct", "user", "migrate", "exit"}


def main(a):
    if a and a[0] in LOCKED:
        with state_lock():
            return dispatch(a)
    return dispatch(a)


def dispatch(a):
    if not a or a[0] in ("-h", "--help", "help"):
        print(__doc__.strip())
        return
    c = a[0]
    if c == "list":
        cmd_list("--json" in a[1:])
    elif c == "add" and len(a) in (2, 3):
        cmd_add(a[1], a[2] if len(a) == 3 else None)
    elif c in ("remove", "rm", "del") and len(a) == 2:
        cmd_remove(a[1])
    elif c == "use" and len(a) == 2:
        cmd_use(a[1])
    elif c == "auto":
        cmd_auto()
    elif c == "check":
        cmd_check("--json" in a[1:])
    elif c == "direct" and len(a) >= 2 and a[1] in ("builtin", "country"):
        cmd_builtin(a[2:] if a[1] == "builtin" else a[1:])
    elif c == "direct" and len(a) >= 2:
        rest = [x for x in a[2:] if x != "--json"]
        cmd_direct(a[1], rest[0] if rest else None, "--json" in a[2:])
    elif c == "sni":
        cmd_sni(a[1:])
    elif c == "user":
        cmd_user(a[1:])
    elif c == "status":
        cmd_status(a[1:])
    elif c == "exit":
        cmd_exit(a[1:])
    elif c == "health":
        cmd_health(a[1:])
    elif c == "reach":
        cmd_reach(a[1:])
    elif c == "migrate":
        cmd_migrate(a[1:])
    else:
        print(__doc__.strip())
        sys.exit(1)


if __name__ == "__main__":
    main(sys.argv[1:])

def die(msg):
    print("Ошибка: " + msg, file=sys.stderr)
    sys.exit(1)


def load(path, default=None):
    if not os.path.exists(path):
        if default is not None:
            return default
        die(f"не найден {path}")
    with open(path) as f:
        return json.load(f)


def save(path, data):
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        json.dump(data, f, ensure_ascii=False, indent=2)
        f.write("\n")
    os.replace(tmp, path)


def exits_list(ex):
    return [o for o in ex.get("outbounds", []) if o.get("tag", "").startswith(PREFIX)]


def find_rule(base, tag):
    for r in base.get("routing", {}).get("rules", []):
        if r.get("ruleTag") == tag:
            return r
    return None


def balancer(base):
    for b in base.get("routing", {}).get("balancers", []):
        if b.get("tag") == "exits":
            return b
    die("в 00_base.json нет балансировщика с тегом exits")


def sync_fallback(base, ex):
    """fallbackTag = первый выход, чтобы трафик шёл, пока observatory не проверил выходы."""
    b = balancer(base)
    tags = [o["tag"] for o in exits_list(ex)]
    if tags:
        b["fallbackTag"] = tags[0]
    else:
        b.pop("fallbackTag", None)


def write_and_test(base, ex):
    """Сохранить и проверить конфиг; при ошибке откатить."""
    backups = {}
    for p in (BASE, EXITS):
        if os.path.exists(p):
            shutil.copy2(p, p + ".bak")
            backups[p] = p + ".bak"
    save(BASE, base)
    save(EXITS, ex)
    test = subprocess.run([XRAY, "run", "-test", "-confdir", CONF_DIR],
                          capture_output=True, text=True)
    if test.returncode != 0:
        for p, b in backups.items():
            shutil.copy2(b, p)
        out = (test.stdout + test.stderr).strip().splitlines()
        die("конфиг не прошёл проверку, изменения отменены:\n  " + "\n  ".join(out[-5:]))


def restart_xray():
    if NO_RESTART:
        print("Конфиг OK (перезапуск пропущен: XRAY_NO_RESTART=1)")
        return
    # Счётчики Xray живут до перезапуска: сначала переносим их в накопленный трафик.
    if os.path.exists(BASE):
        meta = load_meta()
        if collect_traffic(meta):
            save_meta(meta)
    r = subprocess.run(["systemctl", "restart", "xray"], capture_output=True, text=True)
    if r.returncode != 0:
        die("не удалось перезапустить xray: " + r.stderr.strip())
    time.sleep(1)
    st = subprocess.run(["systemctl", "is-active", "xray"], capture_output=True, text=True)
    if st.stdout.strip() != "active":
        die("xray не запустился, смотрите: journalctl -u xray -n 50")
    print("Xray перезапущен.")


def apply(base, ex):
    """Сохранить, проверить конфиг, перезапустить; при ошибке проверки откатить."""
    write_and_test(base, ex)
    restart_xray()


def live_ok(base, needed):
    """Можно ли передать изменение запущенному Xray через API: нужные сервисы включены и Xray работает."""
    services = (base.get("api") or {}).get("services") or []
    return all(s in services for s in needed) and run_text("systemctl", "is-active", "xray") == "active"


def live_users_ok(base):
    """Можно ли менять пользователей через API, без перезапуска Xray."""
    return live_ok(base, ("HandlerService",))


def upgrade_api(base, needed):
    """Серверы, поставленные до появления изменений на лету: включить сервисы API.

    Если в api нет чего-то из needed, добавляются все сервисы из LIVE_SERVICES, и функция
    возвращает True: настройки API изменились, поэтому в этот раз Xray всё равно перезапустится.
    Без api (простой режим старых версий) ничего не меняется.
    """
    api = base.get("api")
    if not api:
        return False
    services = api.setdefault("services", [])
    if all(s in services for s in needed):
        return False
    services.extend(s for s in LIVE_SERVICES if s not in services)
    return True


def api_call(*args):
    try:
        r = subprocess.run([XRAY, "api", args[0], f"--server={API_SERVER}", *args[1:]],
                           capture_output=True, text=True, timeout=15)
    except (OSError, subprocess.SubprocessError):
        return False
    return r.returncode == 0


def api_json(cmd, data):
    """Вызов API с JSON во временном файле: так xray api принимает конфиги."""
    fd, path = tempfile.mkstemp(suffix=".json")
    try:
        with os.fdopen(fd, "w") as f:
            json.dump(data, f)
        return api_call(cmd, path)
    finally:
        os.remove(path)


def apply_routing_change(base, ex, old_ex):
    """Записать конфиг и передать запущенному Xray изменения выходов и правил. True, если Xray перезапущен.

    Выходы добавляются и удаляются через HandlerService (ado, rmo): балансировщик и observatory
    сами видят новый набор по префиксу exit-. Правила и балансировщик целиком заменяются через
    RoutingService (adrules без -append). Порядок: сначала новые выходы, затем правила, которые
    могут на них ссылаться, и только потом удаление старых. Если API нет или он отказал — перезапуск,
    конфиг на диске при этом уже новый.
    """
    if upgrade_api(base, LIVE_SERVICES) or not live_ok(base, LIVE_SERVICES):
        apply(base, ex)
        return True
    write_and_test(base, ex)
    old = {o["tag"]: o for o in exits_list(old_ex)}
    new = {o["tag"]: o for o in exits_list(ex)}
    changed = [t for t in new if t in old and new[t] != old[t]]
    added = [new[t] for t in new if t not in old or t in changed]
    gone = [t for t in old if t not in new]
    ok = (all(api_call("rmo", t) for t in changed)
          and (not added or api_json("ado", {"outbounds": added}))
          and api_json("adrules", {"routing": base["routing"]})
          and all(api_call("rmo", t) for t in gone))
    if ok:
        print("Изменение применено без перезапуска Xray.")
        return False
    print("Не удалось применить изменение на лету, перезапускаю Xray.")
    restart_xray()
    return True


def apply_users_change(base, ex, added=(), removed=()):
    """Записать конфиг и применить изменения пользователей. True, если Xray пришлось перезапустить.

    Конфиг на диске меняется всегда, чтобы после любого перезапуска состояние совпадало.
    Запущенному Xray изменение передаётся через API; если API недоступен или отказал — перезапуск.
    """
    if not live_users_ok(base):
        apply(base, ex)
        return True
    write_and_test(base, ex)
    ok = True
    if added:
        ib = json.loads(json.dumps(inbound_in(base)))
        ib["settings"]["clients"] = list(added)
        ok = api_json("adu", {"inbounds": [ib]})
    for c in removed:
        ok = ok and api_call("rmu", "-tag=in", client_name(c))
    if ok:
        print("Изменение применено без перезапуска Xray.")
        return False
    print("Не удалось применить изменение на лету, перезапускаю Xray.")
    restart_xray()
    return True


def clean_name(s):
    s = unquote(s or "").strip().lower()
    s = re.sub(r"[^a-z0-9_-]+", "-", s).strip("-")
    return s[:32]


def parse_vless(link, name=None):
    if not link.startswith("vless://"):
        die("ссылка должна начинаться с vless://")
    u = urlsplit(link)
    q = {k: v[0] for k, v in parse_qs(u.query).items()}
    uid = unquote(u.username or "")
    host = u.hostname
    try:
        port = u.port or 443
    except ValueError:
        die("неверный порт в ссылке")
    if not uid or not host:
        die("в ссылке нет UUID или адреса")

    net = q.get("type", "tcp")
    if net == "raw":
        net = "tcp"
    sec = q.get("security", "none")
    user = {"id": uid, "encryption": q.get("encryption", "none")}
    if q.get("flow"):
        user["flow"] = q["flow"]

    ss = {"network": net, "security": sec}
    if sec == "reality":
        if not q.get("pbk"):
            die("для reality в ссылке нужен pbk (публичный ключ)")
        rs = {"serverName": q.get("sni", ""), "publicKey": q["pbk"],
              "shortId": q.get("sid", ""), "fingerprint": q.get("fp", "chrome")}
        if q.get("spx"):
            rs["spiderX"] = q["spx"]
        ss["realitySettings"] = rs
    elif sec == "tls":
        ts = {"serverName": q.get("sni", host), "fingerprint": q.get("fp", "chrome")}
        if q.get("alpn"):
            ts["alpn"] = q["alpn"].split(",")
        ss["tlsSettings"] = ts
    elif sec != "none":
        die(f"неизвестный security={sec}")

    if net == "ws":
        ss["wsSettings"] = {"path": q.get("path", "/"), "host": q.get("host", "")}
    elif net == "grpc":
        ss["grpcSettings"] = {"serviceName": q.get("serviceName", "")}
    elif net == "xhttp":
        xs = {"path": q.get("path", "/"), "host": q.get("host", "")}
        if q.get("mode"):
            xs["mode"] = q["mode"]
        ss["xhttpSettings"] = xs
    elif net == "httpupgrade":
        ss["httpupgradeSettings"] = {"path": q.get("path", "/"), "host": q.get("host", "")}
    elif net != "tcp":
        die(f"неподдерживаемый type={net}")

    nm = clean_name(name) or clean_name(u.fragment) or clean_name(host.replace(".", "-"))
    return {
        "tag": PREFIX + nm,
        "protocol": "vless",
        "settings": {"vnext": [{"address": host, "port": port, "users": [user]}]},
        "streamSettings": ss,
    }


def info(o):
    v = o["settings"]["vnext"][0]
    s = o.get("streamSettings", {})
    return v["address"], v["port"], f'{s.get("network", "tcp")}/{s.get("security", "none")}'


def mode_str(base):
    r = find_rule(base, RULE_EXITS)
    if r and r.get("outboundTag"):
        return "закреплён выход " + r["outboundTag"][len(PREFIX):]
    return "авто (самый быстрый живой выход)"


def cmd_list(as_json=False):
    base, ex = load(BASE), load(EXITS, {"outbounds": []})
    items = exits_list(ex)
    if as_json:
        r = find_rule(base, RULE_EXITS)
        pinned = r.get("outboundTag") if r else None
        rows = []
        for o in items:
            a, p, t = info(o)
            rows.append({"name": o["tag"][len(PREFIX):], "address": a, "port": p, "transport": t})
        print(json.dumps({"pinned": pinned[len(PREFIX):] if pinned else None, "exits": rows},
                         ensure_ascii=False, indent=2))
        return
    print("Режим:", mode_str(base))
    if not items:
        print("Выходов нет. Добавьте: exitctl add 'vless://...' имя")
        return
    print(f'{"ИМЯ":<20} {"АДРЕС":<28} {"ПОРТ":<6} ТРАНСПОРТ')
    for o in items:
        a, p, t = info(o)
        print(f'{o["tag"][len(PREFIX):]:<20} {a:<28} {p:<6} {t}')


def cmd_add(link, name=None):
    base, ex = load(BASE), load(EXITS, {"outbounds": []})
    ex.setdefault("outbounds", [])
    old_ex = json.loads(json.dumps(ex))
    o = parse_vless(link, name)
    if any(x.get("tag") == o["tag"] for x in ex["outbounds"]):
        die(f'выход «{o["tag"][len(PREFIX):]}» уже есть. Удалите его или укажите другое имя.')
    ex["outbounds"].append(o)
    sync_fallback(base, ex)
    apply_routing_change(base, ex, old_ex)
    a, p, t = info(o)
    print(f'Добавлен выход «{o["tag"][len(PREFIX):]}»: {a}:{p} ({t})')


def cmd_remove(name):
    base, ex = load(BASE), load(EXITS, {"outbounds": []})
    tag = PREFIX + clean_name(name)
    old_ex = json.loads(json.dumps(ex))
    before = len(ex.get("outbounds", []))
    ex["outbounds"] = [o for o in ex.get("outbounds", []) if o.get("tag") != tag]
    if len(ex["outbounds"]) == before:
        die(f"выход «{name}» не найден (смотрите exitctl list)")
    r = find_rule(base, RULE_EXITS)
    if r and r.get("outboundTag") == tag:
        r.pop("outboundTag")
        r["balancerTag"] = "exits"
        print("Удалённый выход был закреплён — включён режим авто.")
    sync_fallback(base, ex)
    apply_routing_change(base, ex, old_ex)
    print(f"Удалён выход «{clean_name(name)}».")
    if not exits_list(ex):
        print("Внимание: выходов не осталось, зарубежные сайты работать не будут.")


def cmd_use(name):
    base, ex = load(BASE), load(EXITS, {"outbounds": []})
    tag = PREFIX + clean_name(name)
    if tag not in [o["tag"] for o in exits_list(ex)]:
        die(f"выход «{name}» не найден (смотрите exitctl list)")
    r = find_rule(base, RULE_EXITS) or die("в 00_base.json нет правила to-exits")
    r.pop("balancerTag", None)
    r["outboundTag"] = tag
    apply_routing_change(base, ex, ex)
    print(f"Весь трафик теперь идёт через «{clean_name(name)}».")


def cmd_auto():
    base, ex = load(BASE), load(EXITS, {"outbounds": []})
    r = find_rule(base, RULE_EXITS) or die("в 00_base.json нет правила to-exits")
    r.pop("outboundTag", None)
    r["balancerTag"] = "exits"
    sync_fallback(base, ex)
    apply_routing_change(base, ex, ex)
    print("Включён автовыбор самого быстрого живого выхода.")


def exits_health(ex):
    """TCP до каждого выхода: [{name, ok, ms, address, port, error}]."""
    rows = []
    for o in exits_list(ex):
        a, p, _ = info(o)
        t0 = time.time()
        try:
            with socket.create_connection((a, p), timeout=4):
                ms, ok, err = int((time.time() - t0) * 1000), True, None
        except OSError as e:
            ms, ok, err = None, False, e.__class__.__name__
        rows.append({"name": o["tag"][len(PREFIX):], "ok": ok, "ms": ms, "address": a, "port": p, "error": err})
    return rows


def cmd_check(as_json=False):
    rows = exits_health(load(EXITS, {"outbounds": []}))
    if as_json:
        print(json.dumps([{k: r[k] for k in ("name", "ok", "ms")} for r in rows], ensure_ascii=False, indent=2))
        return
    if not rows:
        print("Выходов нет.")
    for r in rows:
        res = f'OK, {r["ms"]} мс' if r["ok"] else f'НЕДОСТУПЕН ({r["error"]})'
        print(f'{r["name"]:<20} {r["address"]}:{r["port"]:<6} {res}')


def cmd_direct(action, domain=None, as_json=False):
    base, ex = load(BASE), load(EXITS, {"outbounds": []})
    rules = base["routing"]["rules"]
    r = find_rule(base, RULE_DIRECT)
    doms = list(r["domain"]) if r else []
    if action == "list":
        names = [d.replace("domain:", "") for d in doms]
        if as_json:
            print(json.dumps(names, ensure_ascii=False))
        else:
            print("\n".join(names) or "Список пуст.")
        return
    if not domain:
        die("укажите домен, например: exitctl direct add gosuslugi.ru")
    d = "domain:" + domain.strip().lower().removeprefix("https://").removeprefix("http://").split("/")[0]
    if action == "add":
        if d in doms:
            die("домен уже в списке")
        doms.append(d)
    elif action == "remove":
        if d not in doms:
            die("домена нет в списке")
        doms.remove(d)
    else:
        die("используйте: direct add|remove|list")
    if r:
        rules.remove(r)
    if doms:
        rules.insert(0, {"ruleTag": RULE_DIRECT, "domain": doms, "outboundTag": "direct"})
    apply_routing_change(base, ex, ex)
    print(("Добавлен" if action == "add" else "Удалён") + f" {d[7:]}")


def geo_codes(kind):
    """Имена списков в geoip.dat или geosite.dat (заглавными) или None, если файла нет.

    Файл — protobuf: повторяющееся поле 1 (запись), у записи поле 1 — имя. Читаются только имена.
    Установщик Xray ставит урезанный geoip (из стран — RU, CN, IR), полный даёт v2fly.
    """
    def varint(b, i):
        r = sh = 0
        while True:
            x = b[i]
            i += 1
            r |= (x & 0x7f) << sh
            sh += 7
            if x < 0x80:
                return r, i
    for d in (os.environ.get("XRAY_LOCATION_ASSET"), os.path.dirname(XRAY), GEO_DIR):
        path = os.path.join(d, f"{kind}.dat") if d else None
        if not path or not os.path.exists(path):
            continue
        with open(path, "rb") as f:
            b = f.read()
        names, i = set(), 0
        try:
            while i < len(b):
                _, i = varint(b, i)
                ln, i = varint(b, i)
                entry, i = b[i:i + ln], i + ln
                _, j = varint(entry, 0)
                nl, j = varint(entry, j)
                names.add(entry[j:j + nl].decode("ascii", "replace").upper())
        except IndexError:
            return None
        return names
    return None


def geo_missing(entry):
    """Сообщение, если записи geoip:/geosite: нет в списках на сервере; None, если есть или файла нет."""
    kind, _, name = entry.partition(":")
    if kind not in ("geoip", "geosite"):
        return None
    name = name.lstrip("!").split("@")[0]
    codes = geo_codes(kind)
    if codes is None or name.upper() in codes:
        return None
    return (f"в списках {kind}.dat на сервере нет «{name}». Обновите списки сайтов в «Обслуживании» приложения: "
            "оно ставит полные списки v2fly, а установщик Xray — урезанные, где из стран есть только ru, cn и ir")


def country_preset(cc):
    """Встроенные списки «напрямую» для страны моста: (домены, адреса)."""
    if cc == "ru":
        return list(RU_DOMAINS), ["geoip:ru", "geoip:private"]
    missing = geo_missing(f"geoip:{cc}")
    if missing:
        die(missing)
    domains = [f"domain:{cc}"]
    if not geo_missing(f"geosite:category-{cc}") and geo_codes("geosite") is not None:
        domains.insert(0, f"geosite:category-{cc}")
    return domains, [f"geoip:{cc}", "geoip:private"]


def builtin_rules(base):
    """Правила встроенных списков: (домены, адреса), каждое — правило или None.

    В установках до появления тегов правила ищутся по виду (direct, домены или адреса,
    не user-direct) и получают теги, чтобы дальше их находить по имени.
    """
    rules = base["routing"]["rules"]
    found = {}
    for tag, key in ((RULE_BUILTIN_DOMAINS, "domain"), (RULE_BUILTIN_IPS, "ip")):
        r = find_rule(base, tag)
        if not r:
            r = next((x for x in rules if x.get("outboundTag") == "direct" and key in x
                      and not x.get("ruleTag") and len(x) == 2), None)
            if r:
                r["ruleTag"] = tag
        found[key] = r
    return found["domain"], found["ip"]


def set_builtin(base, domains, ips):
    """Заменить встроенные списки. Пустой список — правила нет: Xray не принимает правило без условий."""
    rules = base["routing"]["rules"]
    for tag, key, values in ((RULE_BUILTIN_DOMAINS, "domain", domains), (RULE_BUILTIN_IPS, "ip", ips)):
        r = builtin_rules(base)[0 if key == "domain" else 1]
        if r and not values:
            rules.remove(r)
        elif r:
            r[key] = list(values)
        elif values:
            # Новое правило — перед to-exits, после остальных, а домены — перед адресами.
            pos = next((i for i, x in enumerate(rules) if x.get("ruleTag") in (RULE_EXITS, RULE_BUILTIN_IPS)), len(rules))
            rules.insert(pos, {"ruleTag": tag, key: list(values), "outboundTag": "direct"})


def builtin_entry(raw):
    """Запись встроенного списка: ("domain"|"ip", значение) или die."""
    v = raw.strip().lower()
    if re.fullmatch(r"geosite:[a-z0-9!@._-]+", v) or re.fullmatch(r"(domain|full|keyword):[a-z0-9._-]+", v):
        return "domain", v
    if re.fullmatch(r"geoip:!?[a-z0-9_-]+", v):
        return "ip", v
    with contextlib.suppress(ValueError):
        return "ip", str(ipaddress.ip_network(v, strict=False))
    die(f"«{raw}» не похоже на запись списка: geosite:категория, domain:зона, full:домен, keyword:слово, "
        "geoip:страна или IP/сеть")


def cmd_builtin(a):
    """exitctl direct builtin [--json] | add <запись> | remove <запись>; exitctl direct country <код>."""
    as_json = "--json" in a
    a = [x for x in a if x != "--json"]
    base, ex = load(BASE), load(EXITS, {"outbounds": []})
    if not base.get("routing", {}).get("balancers"):
        die("встроенные списки есть только на мосту: простой сервер и так всё открывает напрямую")
    rd, ri = builtin_rules(base)
    domains, ips = list(rd["domain"]) if rd else [], list(ri["ip"]) if ri else []
    if not a:
        if as_json:
            print(json.dumps({"domains": domains, "ips": ips}, ensure_ascii=False, indent=2))
        else:
            print("Домены:", ", ".join(domains) or "—")
            print("Адреса:", ", ".join(ips) or "—")
        return
    if a[0] == "country" and len(a) == 2:
        cc = a[1].strip().lower()
        if not re.fullmatch(r"[a-z]{2}", cc):
            die("код страны — две латинские буквы, например ru, by, kz")
        domains, ips = country_preset(cc)
        what = f"списки для страны {cc}"
    elif a[0] in ("add", "remove") and len(a) == 2:
        kind, v = builtin_entry(a[1])
        lst = domains if kind == "domain" else ips
        if a[0] == "add":
            if v in lst:
                die(f"{v} уже в списке")
            missing = geo_missing(v)
            if missing:
                die(missing)
            lst.append(v)
        else:
            if v not in lst:
                die(f"{v} нет в списке")
            lst.remove(v)
        what = ("добавлено " if a[0] == "add" else "убрано ") + v
    else:
        die("используйте: exitctl direct builtin [add|remove <запись>] [--json] или exitctl direct country <код>")
    set_builtin(base, domains, ips)
    with contextlib.redirect_stdout(sys.stderr if as_json else sys.stdout):
        apply_routing_change(base, ex, ex)
    if as_json:
        print(json.dumps({"domains": domains, "ips": ips}, ensure_ascii=False, indent=2))
    else:
        print(f"Встроенные списки: {what}.")


def normalize_domain(s):
    d = s.strip().lower().removeprefix("https://").removeprefix("http://")
    d = d.split("/")[0].split(":")[0].rstrip(".")
    try:
        d = d.encode("idna").decode()
    except UnicodeError:
        return None
    ok = re.fullmatch(r"([a-z0-9]([a-z0-9-]*[a-z0-9])?\.)+[a-z][a-z0-9-]*[a-z0-9]", d)
    return d if ok else None


def detect_server_ip():
    try:
        with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as s:
            s.connect(("1.1.1.1", 53))
            ip = s.getsockname()[0]
        if ipaddress.ip_address(ip).is_global:
            return ip
    except OSError:
        pass
    try:
        with urlopen("https://api.ipify.org", timeout=5) as r:
            ip = r.read().decode().strip()
        ipaddress.ip_address(ip)
        return ip
    except (OSError, ValueError):
        return None


def resolve_ipv4(domain):
    try:
        infos = socket.getaddrinfo(domain, SNI_PORT, socket.AF_INET, socket.SOCK_STREAM)
    except OSError:
        return []
    return sorted({i[4][0] for i in infos})


def sni_context():
    ctx = ssl.create_default_context()
    ctx.verify_flags &= ~ssl.VERIFY_X509_STRICT
    ctx.minimum_version = ssl.TLSVersion.TLSv1_3
    ctx.set_alpn_protocols(["h2", "http/1.1"])
    return ctx


def tls_handshake(domain, ip, verify, res):
    ctx = sni_context()
    if not verify:
        ctx.check_hostname = False
        ctx.verify_mode = ssl.CERT_NONE
    t0 = time.monotonic()
    with socket.create_connection((ip, SNI_PORT), timeout=SNI_TIMEOUT) as raw:
        res["tcp_ms"] = round((time.monotonic() - t0) * 1000, 1)
        with ctx.wrap_socket(raw, server_hostname=domain) as s:
            res["version"] = s.version()
            res["alpn"] = s.selected_alpn_protocol()
            if verify:
                res["cert"] = s.getpeercert()


def probe_tls(domain, ip):
    res = {"tcp_ms": None, "version": None, "alpn": None, "cert": None,
           "cert_error": None, "error": None}
    try:
        try:
            tls_handshake(domain, ip, True, res)
        except ssl.SSLCertVerificationError as e:
            res["cert_error"] = e.verify_message
            tls_handshake(domain, ip, False, res)
    except OSError as e:  # ssl.SSLError тоже OSError
        res["error"] = str(e) or e.__class__.__name__
    return res


def probe_http(domain, ip):
    """(версия HTTP, код, ошибка curl) или None, если curl нет.

    Сертификат и h2 проверяет probe_tls, поэтому здесь -k и нет --http2:
    сборка curl без HTTP/2 с этим флагом вообще не делает запрос.
    """
    cmd = ["curl", "-sSk", "-o", os.devnull, "--tlsv1.3",
           "--max-time", str(SNI_TIMEOUT * 2), "-A", "Mozilla/5.0",
           "--resolve", f"{domain}:{SNI_PORT}:{ip}",
           "-w", "%{http_version} %{http_code}", f"https://{domain}/"]
    try:
        r = subprocess.run(cmd, capture_output=True, text=True)
    except OSError:
        return None
    parts = r.stdout.split()
    err = r.stderr.strip().splitlines()[0] if r.stderr.strip() else ""
    return (parts[0], parts[1], err) if len(parts) == 2 else ("0", "000", err)


def cert_details(cert):
    def field(rdns, key):
        return next((v for rdn in rdns for k, v in rdn if k == key), None)
    expires = ssl.cert_time_to_seconds(cert["notAfter"])
    return {
        "subject": field(cert.get("subject", ()), "commonName"),
        "issuer": field(cert.get("issuer", ()), "organizationName"),
        "san": [v for k, v in cert.get("subjectAltName", ()) if k == "DNS"],
        "days_left": int((expires - time.time()) // 86400),
    }


def sni_check(raw_domain, server_ip=None, tries=3):
    report = {"domain": raw_domain, "server_ip": server_ip, "verdict": "ok",
              "checks": [], "details": {}}
    det = report["details"]

    def add(cid, status, message):
        report["checks"].append({"id": cid, "status": status, "message": message})

    def finish():
        statuses = [c["status"] for c in report["checks"]]
        report["verdict"] = "fail" if "fail" in statuses else "warn" if "warn" in statuses else "ok"
        return report

    domain = normalize_domain(raw_domain)
    if not domain:
        add("domain", "fail", "это не доменное имя (IP-адреса и служебные имена не подходят)")
        return finish()
    report["domain"] = domain

    ips = resolve_ipv4(domain)
    det["ips"] = ips
    if not ips:
        add("dns", "fail", "домен не резолвится в IPv4")
        return finish()
    non_global = [ip for ip in ips if not ipaddress.ip_address(ip).is_global]
    if non_global:
        add("dns", "fail", "домен указывает на непубличный адрес: " + ", ".join(non_global))
        return finish()
    add("dns", "pass", "резолвится в " + ", ".join(ips))

    target = ips[0]
    if server_ip:
        if server_ip in ips:
            add("not_self", "fail", "домен указывает на сам этот сервер")
            return finish()
        net = ipaddress.ip_network(server_ip + "/24", strict=False)
        near = [ip for ip in ips if ipaddress.ip_address(ip) in net]
        if near:
            target = near[0]
            add("same_subnet", "pass", f"{target} в одной /24 с сервером {server_ip}")
        else:
            add("same_subnet", "warn", f"домен не в /24 сервера {server_ip}")
    else:
        add("same_subnet", "warn", "IP сервера не определён, укажите его через --ip")
    det["checked_ip"] = target

    probes, https = [], []
    for i in range(tries):
        if i:
            time.sleep(1)
        probes.append(probe_tls(domain, target))
        https.append(probe_http(domain, target))

    connected = [p for p in probes if p["tcp_ms"] is not None]
    if len(connected) < tries:
        add("tcp", "fail", f"порт {SNI_PORT} ответил в {len(connected)} попытках из {tries}")
        return finish()
    add("tcp", "pass", f"порт {SNI_PORT} отвечает во всех попытках ({tries})")

    shaken = [p for p in probes if p["version"]]
    if len(shaken) < tries:
        err = next((p["error"] for p in probes if p["error"]), "нет ответа")
        add("tls13", "fail", f"TLS 1.3 прошёл в {len(shaken)} попытках из {tries}: {err}")
        return finish()
    det["tls_version"] = shaken[0]["version"]
    add("tls13", "pass", "TLS 1.3 во всех попытках")

    alpns = {p["alpn"] for p in probes}
    det["alpn"] = sorted(a or "нет" for a in alpns)
    if alpns == {"h2"}:
        add("h2", "pass", "сервер выбирает h2 (ALPN)")
    else:
        add("h2", "fail", "сервер не всегда выбирает h2: " + ", ".join(det["alpn"]))

    cert_err = next((p["cert_error"] for p in probes if p["cert_error"]), None)
    good = next((p["cert"] for p in probes if p["cert"]), None)
    if cert_err or not good:
        add("cert", "fail", "сертификат не прошёл проверку: " + (cert_err or "нет данных"))
    else:
        det["cert"] = cert_details(good)
        days = det["cert"]["days_left"]
        add("cert", "warn" if days < SNI_CERT_MIN_DAYS else "pass",
            f'сертификат действителен, выдан {det["cert"]["issuer"]}, осталось дней: {days}')

    if any(h is None for h in https):
        add("http", "warn", "curl не найден, HTTP-ответ не проверен")
    else:
        codes = sorted({h[1] for h in https})
        det["http_status"] = codes
        det["http_version"] = sorted({h[0] for h in https})
        if all(c.startswith("2") for c in codes):
            add("http", "pass", "HTTP-ответ " + ", ".join(codes))
        elif all(c[0] in "23" for c in codes):
            add("http", "warn", "сайт отвечает перенаправлением: " + ", ".join(codes))
        else:
            err = next((h[2] for h in https if h[2]), "")
            add("http", "fail", "нет рабочего HTTP-ответа: " + ", ".join(codes)
                + (f" ({err})" if err else ""))

    rtt = round(statistics.median(p["tcp_ms"] for p in probes), 1)
    det["tcp_ms"] = rtt
    add("latency", "warn" if rtt > SNI_MAX_RTT_MS else "pass", f"задержка от сервера {rtt} мс")
    return finish()


def cert_names(cert):
    """Имена из сертификата: SAN и CN, вместо *.example.com — example.com."""
    raw = [v for k, v in cert.get("subjectAltName", ()) if k == "DNS"]
    raw += [v for rdn in cert.get("subject", ()) for k, v in rdn if k == "commonName"]
    names = []
    for n in raw:
        d = normalize_domain(n[2:] if n.startswith("*.") else n)
        if d and d not in names:
            names.append(d)
    return names


def scan_host(ip):
    """Имена с действительного сертификата хоста или None. Без SNI: отдаётся сертификат по умолчанию."""
    ctx = sni_context()
    ctx.check_hostname = False  # имя ещё неизвестно, цепочку всё равно проверяем
    try:
        with socket.create_connection((ip, SNI_PORT), timeout=SCAN_TIMEOUT) as raw:
            with ctx.wrap_socket(raw) as s:
                cert = s.getpeercert()
    except OSError:
        return None
    names = cert_names(cert)
    return {"ip": ip, "names": names} if names else None


def reject_reason(domain):
    if RE_RDNS.search(domain):
        return "имя похоже на обратную зону хостера"
    if RE_VPN.search(domain) or any(RE_NODE.match(label) for label in domain.split(".")[:-2]):
        return "имя похоже на VPN-ноду"
    if RE_BRAND.search(domain) or domain.endswith(".mail.ru") or domain == "mail.ru":
        return "крупный бренд в подсети VPS выглядит подозрительно"
    if RE_SERVICE.search(domain):
        return "служебное имя"
    return None


def domain_depth(domain):
    """Сколько уровней над основным доменом: www не считается."""
    return max(0, len(domain.removeprefix("www.").split(".")) - 2)


def score_candidate(domain, found_ip, check, role):
    det = check["details"]
    statuses = {c["id"]: c["status"] for c in check["checks"]}
    score, reasons = 100, []

    def adj(delta, reason):
        nonlocal score
        score += delta
        reasons.append(f"{delta:+d}: {reason}")

    if found_ip in det.get("ips", []):
        adj(10, "сертификат найден на том же IP, что в DNS")
    else:
        adj(-10, "сертификат найден на другом IP, чем в DNS")
    rtt = det.get("tcp_ms")
    if rtt is not None and rtt <= 10:
        adj(10, f"низкая задержка, {rtt} мс")
    elif statuses.get("latency") == "warn":
        adj(-20, f"высокая задержка, {rtt} мс")
    if statuses.get("http") == "warn":
        adj(-15, "корень сайта отвечает перенаправлением или HTTP не проверен")
    if statuses.get("cert") == "warn":
        adj(-20, "сертификат скоро истекает")
    is_ru = domain.rsplit(".", 1)[-1] in RU_TLDS
    if role == "bridge" and is_ru:
        adj(15, "российский домен для моста в РФ")
    elif role == "exit" and is_ru:
        adj(-15, "российский домен на зарубежном выходе")
    if domain.count("-") >= 2 or sum(ch.isdigit() for ch in domain) >= 3:
        adj(-10, "имя выглядит не как обычный сайт")
    if domain_depth(domain) > 0:
        adj(-10, "поддомен, а не основной сайт")
    if RE_INFRA.search(domain):
        adj(-15, "имя похоже на техническое")
    if RE_RANDOM.search(domain.split(".")[-2]):
        adj(-20, "имя похоже на случайный набор букв")
    return score, reasons


def sni_scan(server_ip, role=None, top=5, workers=8, max_checks=25, log=lambda m: None):
    net = ipaddress.ip_network(server_ip + "/24", strict=False)
    hosts = [str(h) for h in net.hosts() if str(h) != server_ip]
    log(f"Сканирую {len(hosts)} адресов в {net}, одновременно до {workers} соединений...")
    with ThreadPoolExecutor(max_workers=workers) as pool:
        found = [r for r in pool.map(scan_host, hosts) if r]
    log(f"Хостов с TLS 1.3 и действительным сертификатом: {len(found)}")

    rejected, pending, seen = [], [], set()
    for host in found:
        names = sorted(host["names"], key=lambda n: (n.startswith("www."), len(n)))
        fresh = [n for n in names if n not in seen]
        seen.update(fresh)
        accepted = 0
        for i, domain in enumerate(fresh):
            reason = reject_reason(domain)
            if not reason and i >= SCAN_NAMES_PER_HOST:
                reason = "слишком много имён в сертификате"
            if not reason:
                ips = resolve_ipv4(domain)
                if not any(ipaddress.ip_address(ip) in net for ip in ips):
                    reason = "по DNS находится вне /24 сервера"
            if reason:
                rejected.append({"domain": domain, "ip": host["ip"], "reason": reason})
            elif accepted >= SCAN_CHECKS_PER_HOST:
                rejected.append({"domain": domain, "ip": host["ip"],
                                 "reason": "на этом хосте уже проверяются другие имена"})
            else:
                pending.append((accepted, domain, host["ip"]))
                accepted += 1

    # Сначала первые имена всех хостов: лимит проверок не должен съесть один хост.
    # Среди них вперёд основные домены: они лучше подходят и получают более высокую оценку.
    pending.sort(key=lambda p: (p[0], domain_depth(p[1]) > 0))
    checked, skipped = pending[:max_checks], pending[max_checks:]
    for _, domain, ip in skipped:
        rejected.append({"domain": domain, "ip": ip, "reason": "не хватило лимита проверок (--max-checks)"})

    best = {}
    for n, (_, domain, ip) in enumerate(checked, 1):
        log(f"Проверяю {n}/{len(checked)}: {domain}")
        check = sni_check(domain, server_ip, 2)
        statuses = {c["id"]: c for c in check["checks"]}
        failed = next((c for c in check["checks"] if c["status"] == "fail"), None)
        if failed:
            rejected.append({"domain": domain, "ip": ip, "reason": failed["message"]})
        elif statuses.get("same_subnet", {}).get("status") != "pass":
            rejected.append({"domain": domain, "ip": ip, "reason": "по DNS находится вне /24 сервера"})
        else:
            score, reasons = score_candidate(domain, ip, check, role)
            cand = {"domain": domain, "ip": ip, "score": score, "reasons": reasons, "check": check}
            # Один лучший домен на IP: иначе список займёт один общий хостинг
            if ip not in best or score > best[ip]["score"]:
                best[ip] = cand

    candidates = sorted(best.values(), key=lambda c: (-c["score"], c["domain"]))
    return {"server_ip": server_ip, "subnet": str(net), "role": role,
            "hosts_scanned": len(hosts), "hosts_with_tls": len(found),
            "candidates": candidates[:top], "rejected": rejected}


def valid_public_ipv4(ip, opt="--ip"):
    try:
        addr = ipaddress.ip_address(ip)
    except ValueError:
        die(f"{opt}: неверный адрес {ip}")
    if addr.version != 4:
        die(f"{opt}: нужен IPv4-адрес")
    return addr


def int_opt(opts, name, low, high):
    v = opts.pop(0)
    if not v.isdigit() or not low <= int(v) <= high:
        die(f"{name}: нужно число от {low} до {high}")
    return int(v)


def cmd_sni_scan(opts):
    as_json, ip, role, top, workers, max_checks = False, None, None, 5, 8, 25
    while opts:
        o = opts.pop(0)
        if o == "--json":
            as_json = True
        elif o == "--ip" and opts:
            ip = opts.pop(0)
            valid_public_ipv4(ip)
        elif o == "--role" and opts:
            role = opts.pop(0)
            if role not in ("bridge", "exit"):
                die("--role: используйте bridge или exit")
        elif o == "--top" and opts:
            top = int_opt(opts, o, 1, 50)
        elif o == "--workers" and opts:
            workers = int_opt(opts, o, 1, 32)
        elif o == "--max-checks" and opts:
            max_checks = int_opt(opts, o, 1, 100)
        else:
            die(f"неизвестный параметр {o}")

    ip = ip or detect_server_ip()
    if not ip:
        die("не удалось определить IP сервера, укажите его через --ip")
    if not ipaddress.ip_address(ip).is_global:
        die(f"{ip} — непубличный адрес, укажите внешний IP сервера через --ip")

    def log(m):
        print(m, file=sys.stderr, flush=True)

    log("Внимание: скан соседних адресов может вызвать жалобу хостеру.")
    rep = sni_scan(ip, role, top, workers, max_checks, log)
    if as_json:
        print(json.dumps(rep, ensure_ascii=False, indent=2))
    else:
        for n, c in enumerate(rep["candidates"], 1):
            print(f'{n}. {c["domain"]} ({c["ip"]}), оценка {c["score"]}')
            for r in c["reasons"]:
                print(f"     {r}")
        print(f'Адресов: {rep["hosts_scanned"]}, с TLS 1.3 и действительным сертификатом: '
              f'{rep["hosts_with_tls"]}, отброшено имён: {len(rep["rejected"])}.')
        if rep["candidates"]:
            print("Перед установкой можно перепроверить: exitctl sni check <домен>")
        else:
            print(f'В {rep["subnet"]} подходящих доменов нет. Укажите свой и проверьте его: '
                  "exitctl sni check <домен>")
    if not rep["candidates"]:
        sys.exit(1)


def cmd_sni(a):
    if a and a[0] == "scan":
        cmd_sni_scan(a[1:])
        return
    if len(a) < 2 or a[0] != "check":
        die("используйте: exitctl sni check <домен> [--ip IP] [--tries N] [--json]\n"
            "       или: exitctl sni scan [--ip IP] [--role bridge|exit] [--json]")
    domain, opts = a[1], a[2:]
    as_json, ip, tries = False, None, 3
    while opts:
        o = opts.pop(0)
        if o == "--json":
            as_json = True
        elif o == "--ip" and opts:
            ip = opts.pop(0)
            valid_public_ipv4(ip)
        elif o == "--tries" and opts:
            t = opts.pop(0)
            if not t.isdigit() or not 1 <= int(t) <= 10:
                die("--tries: нужно число от 1 до 10")
            tries = int(t)
        else:
            die(f"неизвестный параметр {o}")

    rep = sni_check(domain, ip or detect_server_ip(), tries)
    if as_json:
        print(json.dumps(rep, ensure_ascii=False, indent=2))
    else:
        print(f'Домен: {rep["domain"]}   Сервер: {rep["server_ip"] or "не определён"}')
        marks = {"pass": " OK ", "warn": "WARN", "fail": "FAIL"}
        for c in rep["checks"]:
            print(f'[{marks[c["status"]]}] {c["id"]}: {c["message"]}')
        print("Итог:", {"ok": "подходит", "warn": "подходит, но есть предупреждения",
                        "fail": "не подходит"}[rep["verdict"]])
    if rep["verdict"] == "fail":
        sys.exit(1)


def run_text(*cmd):
    """stdout команды или None, если её нет или она завершилась ошибкой."""
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.SubprocessError):
        return None
    return r.stdout.strip() if r.returncode == 0 else None


def inbound_in(base):
    for i in base.get("inbounds", []):
        if i.get("tag") == "in":
            return i
    die("в 00_base.json нет inbound с тегом in")


def client_name(c):
    return c.get("email") or c["id"][:8]


def public_key(base):
    priv = inbound_in(base)["streamSettings"]["realitySettings"]["privateKey"]
    out = run_text(XRAY, "x25519", "-i", priv) or ""
    m = re.search(r"^(?:public|password)[^:\n]*:\s*(\S+)", out, re.I | re.M)
    return m.group(1) if m else None


def client_link(base, client, host, pub):
    ib = inbound_in(base)
    rs = ib["streamSettings"]["realitySettings"]
    flow = client.get("flow", "")
    return (f'vless://{client["id"]}@{host}:{ib["port"]}?type=tcp&security=reality'
            f'&sni={rs["serverNames"][0]}&pbk={pub}&sid={rs["shortIds"][0]}&fp=chrome'
            + (f"&flow={flow}" if flow else "") + f"#{client_name(client)}")


def parse_traffic(out):
    """{имя: {uplink, downlink}} из ответа statsquery или None, если ответ не разобрать."""
    try:
        stats = json.loads(out or "{}").get("stat") or []
    except ValueError:
        return None
    res = {}
    for s in stats:
        parts = s.get("name", "").split(">>>")
        if len(parts) == 4 and parts[3] in ("uplink", "downlink"):
            res.setdefault(parts[1], {})[parts[3]] = int(s.get("value", 0))
    return res


def user_traffic():
    """{имя: {uplink, downlink}} или None, если счётчики недоступны.

    Пустой ответ — это не ошибка: пока трафика не было, Xray не возвращает ни одного счётчика.
    Здесь только то, что накопилось с последнего сбора (collect_traffic) или перезапуска Xray.
    """
    out = run_text(XRAY, "api", "statsquery", f"--server={API_SERVER}", "-pattern", "user>>>")
    return None if out is None else parse_traffic(out)


def load_meta():
    meta = load(USERS_META, {})
    meta.setdefault("users", {})
    return meta


def save_meta(meta):
    save(USERS_META, meta)
    with contextlib.suppress(OSError):
        os.chmod(USERS_META, 0o600)  # здесь UUID отключённых пользователей


@contextlib.contextmanager
def state_lock():
    """Одно изменение за раз: cron (user enforce) и приложение могут работать одновременно."""
    try:
        import fcntl
    except ImportError:  # Windows, тесты
        yield
        return
    if not os.path.isdir(os.path.dirname(USERS_META)):
        yield
        return
    fd = os.open(USERS_META + ".lock", os.O_CREAT | os.O_RDWR, 0o600)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX)
        yield
    finally:
        os.close(fd)


def collect_traffic(meta):
    """Перенести счётчики Xray в накопленный трафик (used) и обнулить их. False, если API недоступен."""
    out = run_text(XRAY, "api", "statsquery", f"--server={API_SERVER}", "-pattern", "user>>>", "-reset")
    traffic = None if out is None else parse_traffic(out)
    if traffic is None:
        return False
    for name, t in traffic.items():
        u = meta["users"].setdefault(name, {})
        u["used"] = u.get("used", 0) + t.get("uplink", 0) + t.get("downlink", 0)
    return True


def reconcile(meta, base):
    """Пользователь, который есть в конфиге, не может числиться отключённым.

    Так бывает, если изменение конфига сорвалось после записи файла с ограничениями.
    """
    for c in inbound_in(base)["settings"]["clients"]:
        m = meta["users"].get(client_name(c))
        if m:
            m.pop("client", None)
            m.pop("disabled", None)


def limit_reason(m, now):
    if m.get("expires") and now >= m["expires"]:
        return "expired"
    if m.get("limit") and m.get("used", 0) >= m["limit"]:
        return "traffic"
    return None


def disable_client(base, meta, client, reason):
    inbound_in(base)["settings"]["clients"].remove(client)
    m = meta["users"].setdefault(client_name(client), {})
    m.update(client=client, disabled=reason)


def enable_client(base, meta, name):
    m = meta["users"][name]
    client = m.pop("client")
    m.pop("disabled", None)
    inbound_in(base)["settings"]["clients"].append(client)
    return client


def enforce(base, meta, now):
    """Отключить вышедших за срок или лимит и включить тех, кому их продлили. ([отключённые], [включённые])."""
    off, on = [], []
    for c in list(inbound_in(base)["settings"]["clients"]):
        m = meta["users"].get(client_name(c))
        reason = m and limit_reason(m, now)
        if reason:
            disable_client(base, meta, c, reason)
            off.append((c, reason))
    for name, m in meta["users"].items():
        if m.get("disabled") in ("expired", "traffic") and m.get("client") and not limit_reason(m, now):
            on.append(enable_client(base, meta, name))
    return off, on


def commit_users(base, ex, meta, added=(), removed=()):
    """Сначала файл ограничений (в нём копия отключённых), потом конфиг Xray. True, если был перезапуск.

    Если конфиг не применится, reconcile при следующем запуске вернёт файл к конфигу,
    и ни один пользователь не потеряется.
    """
    save_meta(meta)
    if not added and not removed:
        return False
    return apply_users_change(base, ex, added, removed)


def ensure_cron():
    """Учёт трафика и проверка сроков раз в 5 минут. Ставится установщиками и при первом лимите."""
    if os.path.exists(CRON_FILE) or not os.path.isdir(os.path.dirname(CRON_FILE)):
        return
    with open(CRON_FILE, "w") as f:
        f.write("# exitctl: учёт трафика, сроки и лимиты пользователей\n"
                f"*/5 * * * * root {INSTALLED_TOOL} user enforce >/dev/null 2>&1\n")


def users_report(base, host, meta=None):
    host = host or detect_server_ip()
    pub = public_key(base)
    traffic = user_traffic()
    meta = meta or load_meta()
    known = traffic is not None
    active = inbound_in(base)["settings"]["clients"]
    rows = [(c, None) for c in active]
    rows += [(m["client"], m.get("disabled")) for m in meta["users"].values() if m.get("disabled") and m.get("client")]
    users = []
    for c, disabled in rows:
        name = client_name(c)
        m = meta["users"].get(name, {})
        t = traffic.get(name, {}) if known else {}
        up, down = t.get("uplink", 0), t.get("downlink", 0)
        users.append({"name": name, "uuid": c["id"],
                      "uplink": up if known else None,
                      "downlink": down if known else None,
                      # Всего: накопленное в файле ограничений плюс то, что Xray насчитал с последнего сбора.
                      "total": m.get("used", 0) + up + down,
                      "limit": m.get("limit"), "expires": m.get("expires"),
                      "disabled": disabled,
                      "link": client_link(base, c, host, pub) if host and pub else None})
    return users


def parse_until(v):
    """Дата окончания: 2026-12-31 (конец дня по времени сервера) или ISO-время с поясом."""
    try:
        if re.fullmatch(r"\d{4}-\d{2}-\d{2}", v):
            y, mo, d = map(int, v.split("-"))
            return int(time.mktime((y, mo, d, 23, 59, 59, 0, 0, -1)))
        from datetime import datetime
        dt = datetime.fromisoformat(v)
        if dt.tzinfo is None:
            die("--until: укажите дату (2026-12-31) или время с поясом (2026-12-31T23:59:59+03:00)")
        return int(dt.timestamp())
    except (ValueError, OverflowError):
        die(f"--until: неверная дата {v}")


def fmt_date(ts):
    return time.strftime("%Y-%m-%d %H:%M", time.localtime(ts)) if ts else "—"


def fmt_gb(n):
    return f"{n / GB:.2f} ГБ" if n is not None else "—"


def cmd_user(a):
    usage = ("используйте: exitctl user list|add|link|remove|limit|disable|enable|reset|enforce [имя] "
             "[--host АДРЕС] [--json]")
    if not a:
        die(usage)
    action, rest, name = a[0], a[1:], None
    opts = {"json": False, "host": None, "days": None, "until": None, "no_expiry": False,
            "traffic": None, "no_traffic": False}
    while rest:
        o = rest.pop(0)
        if o == "--json":
            opts["json"] = True
        elif o in ("--host", "--days", "--until", "--traffic") and rest:
            opts[o[2:]] = rest.pop(0)
        elif o == "--no-expiry":
            opts["no_expiry"] = True
        elif o == "--no-traffic":
            opts["no_traffic"] = True
        elif not o.startswith("-") and name is None:
            name = o
        else:
            die(f"неизвестный параметр {o}")
    if opts["host"] and not re.fullmatch(r"[A-Za-z0-9.-]+", opts["host"]):
        die(f'--host: неверный адрес {opts["host"]}')
    as_json, host = opts["json"], opts["host"]

    base, ex = load(BASE), load(EXITS, {"outbounds": []})
    meta = load_meta()
    reconcile(meta, base)
    clients = inbound_in(base)["settings"]["clients"]

    def out(user_rows, text):
        if as_json:
            print(json.dumps(user_rows, ensure_ascii=False, indent=2))
        else:
            print(text)

    if action == "list":
        users = users_report(base, host, meta)
        if as_json:
            print(json.dumps(users, ensure_ascii=False, indent=2))
            return
        print(f'{"ИМЯ":<24} {"ВСЕГО":>11} {"ЛИМИТ":>11} {"ДО":<17} СОСТОЯНИЕ')
        for u in users:
            state = LIMIT_REASONS.get(u["disabled"], "отключён") if u["disabled"] else "активен"
            print(f'{u["name"]:<24} {fmt_gb(u["total"]):>11} {fmt_gb(u["limit"]):>11} '
                  f'{fmt_date(u["expires"]):<17} {state}')
        return

    if action == "enforce":
        if name:
            die(usage)
        collected = collect_traffic(meta)
        off, on = enforce(base, meta, time.time())
        with contextlib.redirect_stdout(sys.stderr if as_json else sys.stdout):
            commit_users(base, ex, meta, added=on, removed=[c for c, _ in off])
        if as_json:
            print(json.dumps({"collected": collected,
                              "disabled": [{"name": client_name(c), "reason": r} for c, r in off],
                              "enabled": [client_name(c) for c in on]}, ensure_ascii=False, indent=2))
        else:
            for c, r in off:
                print(f"Отключён «{client_name(c)}»: {LIMIT_REASONS[r]}.")
            for c in on:
                print(f"Снова включён «{client_name(c)}».")
        return

    if action not in ("add", "link", "remove", "limit", "disable", "enable", "reset") or not name:
        die(usage)
    clean = clean_name(name)
    if not clean:
        die("в имени нужны латинские буквы, цифры, - или _")
    found = next((c for c in clients if client_name(c) == clean), None)
    if clean == BRIDGE_USER and found and action in ("remove", "disable", "limit"):
        die(f"«{BRIDGE_USER}» — мост, который ходит через этот выход: без него мост потеряет выход")
    m = meta["users"].get(clean)
    off_client = m.get("client") if m and m.get("disabled") else None
    # Серверы, поставленные до появления изменений на лету: включаем сервисы API.
    # Это меняет настройки API, поэтому в этот раз Xray всё равно перезапустится.
    upgrade = upgrade_api(base, ("HandlerService",))

    def row():
        # Файл ограничений перечитывается: перезапуск Xray мог дописать в него счётчики.
        return next(u for u in users_report(base, host) if u["name"] == clean)

    def change(added=(), removed=()):
        with contextlib.redirect_stdout(sys.stderr if as_json else sys.stdout):
            if upgrade:
                save_meta(meta)
                apply(base, ex)
                return True
            return commit_users(base, ex, meta, added, removed)

    if action == "link":
        if not found and not off_client:
            die(f"пользователь «{clean}» не найден")
        print(row()["link"] or die("не удалось получить ссылку: укажите --host и проверьте xray"))
    elif action == "add":
        if found or m and m.get("client"):
            die(f"пользователь «{clean}» уже есть")
        client = {"id": str(uuid.uuid4()), "flow": "xtls-rprx-vision", "email": clean}
        clients.append(client)
        meta["users"].pop(clean, None)  # старый счётчик удалённого тёзки
        restarted = change(added=[client])
        user = row()
        user["restarted"] = restarted
        if as_json:
            print(json.dumps(user, ensure_ascii=False, indent=2))
        else:
            print(f"Добавлен пользователь «{clean}».")
            print(user["link"] or "Ссылку получить не удалось: укажите --host и проверьте xray.")
    elif action == "remove":
        if not found and not off_client:
            die(f"пользователь «{clean}» не найден")
        if found and len(clients) == 1:
            die("нельзя удалить последнего пользователя: к серверу некому будет подключиться")
        meta["users"].pop(clean, None)
        if found:
            clients.remove(found)
            change(removed=[found])
        else:
            save_meta(meta)
        print(f"Удалён пользователь «{clean}».")
    else:
        if not found and not off_client:
            die(f"пользователь «{clean}» не найден")
        m = meta["users"].setdefault(clean, {})
        collect_traffic(meta)  # лимит сравнивается со свежим трафиком
        now = time.time()
        added, removed = [], []
        if action == "disable":
            if not found:
                die(f"пользователь «{clean}» уже отключён")
            disable_client(base, meta, found, "manual")
            removed.append(found)
        elif action == "enable" and found:
            die(f"пользователь «{clean}» и так включён")
        elif action == "limit":
            if sum(bool(x) for x in (opts["days"], opts["until"], opts["no_expiry"])) > 1:
                die("укажите что-то одно: --days, --until или --no-expiry")
            if opts["traffic"] and opts["no_traffic"]:
                die("укажите что-то одно: --traffic или --no-traffic")
            if opts["days"]:
                if not re.fullmatch(r"\d{1,4}", opts["days"]) or int(opts["days"]) < 1:
                    die("--days: число дней от 1 до 9999")
                m["expires"] = int(now + int(opts["days"]) * 86400)
            elif opts["until"]:
                m["expires"] = parse_until(opts["until"])
            elif opts["no_expiry"]:
                m.pop("expires", None)
            if opts["traffic"]:
                try:
                    gb = float(opts["traffic"].replace(",", "."))
                except ValueError:
                    gb = 0
                if not 0 < gb <= 1_000_000:
                    die("--traffic: объём в гигабайтах, больше нуля")
                m["limit"] = int(gb * GB)
            elif opts["no_traffic"]:
                m.pop("limit", None)
            ensure_cron()
        elif action == "reset":
            m["used"] = 0
        if action != "disable":
            # Состояние заново по сроку и лимиту: вышел за них — отключается, продлили — включается.
            # Отключённого вручную включает только enable.
            reason = limit_reason(m, now)
            if found and reason:
                disable_client(base, meta, found, reason)
                removed.append(found)
            elif not found and reason:
                if action == "enable":
                    die(f"«{clean}» не включён: {LIMIT_REASONS[reason]}. Продлите срок или увеличьте лимит.")
                if m.get("disabled") != "manual":
                    m["disabled"] = reason
            elif not found and (action == "enable" or m.get("disabled") != "manual"):
                added.append(enable_client(base, meta, clean))
        change(added, removed)
        user = row()
        state = LIMIT_REASONS.get(user["disabled"], "отключён") if user["disabled"] else "активен"
        out(user, f'«{clean}»: {state}; трафик {fmt_gb(user["total"])} из {fmt_gb(user["limit"])}, '
                  f'до {fmt_date(user["expires"])}.')


def read_file(path):
    try:
        with open(path) as f:
            return f.read()
    except OSError:
        return None


def can_connect(host):
    """Только первый IPv4-адрес: перебор всех адресов на закрытом сервере идёт десятки секунд."""
    ips = resolve_ipv4(host)
    if not ips:
        return False
    try:
        with socket.create_connection((ips[0], 443), timeout=3):
            return True
    except OSError:
        return False


def egress_report():
    """Какие внешние адреса доступны с сервера: у части VPS исходящий трафик ограничен."""
    with ThreadPoolExecutor(max_workers=len(EGRESS_HOSTS)) as pool:
        return dict(zip(EGRESS_HOSTS, pool.map(can_connect, EGRESS_HOSTS)))


def capabilities(egress):
    """Для чего годится сервер. Выходу и простому режиму нужен открытый зарубежный трафик.

    Мосту его не нужно, но мост должен доставать до своего выхода: это проверяется
    уже при добавлении выхода, потому что адрес заранее неизвестен.
    """
    reachable = sum(1 for h in EGRESS_FOREIGN if egress.get(h))
    foreign_open = reachable >= len(EGRESS_FOREIGN) - 1
    return {"exit": foreign_open, "simple": foreign_open,
            "bridge": foreign_open or bool(egress.get("ya.ru"))}


def file_sha256(path):
    """SHA-256 файла или None, если его нет: так приложение видит, устарел ли установленный exitctl."""
    try:
        with open(path, "rb") as f:
            return hashlib.sha256(f.read()).hexdigest()
    except OSError:
        return None


def status_report():
    meminfo = dict(re.findall(r"^(\w+):\s+(\d+) kB", read_file("/proc/meminfo") or "", re.M))
    mem_total, mem_avail = meminfo.get("MemTotal"), meminfo.get("MemAvailable")
    loadavg = (read_file("/proc/loadavg") or "").split()
    uptime = (read_file("/proc/uptime") or "").split()
    os_name = re.search(r'^PRETTY_NAME="?([^"\n]*)', read_file("/etc/os-release") or "", re.M)
    disk = shutil.disk_usage("/")
    egress = egress_report()

    rep = {
        "hostname": socket.gethostname(),
        "os": os_name.group(1) if os_name else None,
        "uptime_seconds": int(float(uptime[0])) if uptime else None,
        "load": [float(x) for x in loadavg[:3]],
        "cpu_count": os.cpu_count(),
        "memory": {"total": int(mem_total) * 1024, "available": int(mem_avail) * 1024}
        if mem_total and mem_avail else None,
        "disk": {"total": disk.total, "free": disk.free},
        "public_ip": detect_server_ip(),
        "egress": egress,
        "capabilities": capabilities(egress),
        "xray": {
            "active": run_text("systemctl", "is-active", "xray") == "active",
            "version": ((run_text(XRAY, "version") or "").splitlines() or [None])[0],
        },
        "installed": os.path.exists(BASE),
        "tool_sha256": file_sha256(INSTALLED_TOOL),
        "mode": None, "sni": None, "port": None, "users": None, "exits": None, "bridge_user": False,
    }
    if rep["installed"]:
        base, ex = load(BASE), load(EXITS, {"outbounds": []})
        ib = inbound_in(base)
        rep["mode"] = "bridge" if base.get("routing", {}).get("balancers") else "simple"
        rep["sni"] = ib["streamSettings"]["realitySettings"]["serverNames"][0]
        rep["port"] = ib["port"]
        rep["users"] = len(ib["settings"]["clients"])
        # Выход, открытый для клиентов: простой режим, где один из пользователей — мост.
        rep["bridge_user"] = any(client_name(c) == BRIDGE_USER for c in ib["settings"]["clients"])
        rep["exits"] = len(exits_list(ex))
    elif os.path.exists(EXIT_CONF):
        # Выход настроен exit-setup.sh: один config.json. Установщик Xray кладёт сюда пустой {}.
        try:
            with open(EXIT_CONF) as f:
                inbounds = json.load(f).get("inbounds") or []
            rs = inbounds[0]["streamSettings"]["realitySettings"] if inbounds else None
        except (OSError, ValueError, KeyError, AttributeError):
            rs = None
        if rs:
            rep.update(installed=True, mode="exit", sni=rs["serverNames"][0], port=inbounds[0]["port"])
    return rep



def exit_open():
    """Выход становится и сервером для клиентов: раскладка простого режима с теми же ключами.

    Ключи Reality, порт, SNI и UUID моста сохраняются, так что ссылка на мосту не меняется;
    мост становится пользователем «bridge». Порт 443 открывается всем. Старый config.json
    остаётся на месте: если новый конфиг не запустится, Xray возвращается к нему.
    """
    if os.path.exists(BASE):
        die("этот сервер уже настроен как мост или простой сервер")
    conf = load(EXIT_CONF)
    restored = closed_config(conf)
    try:
        ib = json.loads(json.dumps(conf["inbounds"][0]))
        ib["streamSettings"]["realitySettings"]["privateKey"]
        clients = ib["settings"]["clients"]
    except (KeyError, IndexError, TypeError):
        die(f"{EXIT_CONF} не похож на конфиг выхода, поставленного exit-setup.sh")
    for i, c in enumerate(clients):
        c["email"] = c.get("email") or (BRIDGE_USER if i == 0 else f"{BRIDGE_USER}{i + 1}")
    ib["tag"] = "in"
    ib["sniffing"] = {"enabled": True, "destOverride": ["http", "tls", "quic"], "routeOnly": True}
    base = {
        "log": {"loglevel": "warning", "access": "none"},
        "stats": {},
        "api": {"tag": "api", "listen": API_SERVER, "services": ["HandlerService", "StatsService", "RoutingService"]},
        "policy": {"levels": {"0": {"statsUserUplink": True, "statsUserDownlink": True}}},
        "inbounds": [ib],
        "outbounds": [{"tag": "direct", "protocol": "freedom"}, {"tag": "block", "protocol": "blackhole"}],
        "routing": {"rules": [{"protocol": ["bittorrent"], "outboundTag": "block"},
                              {"ip": ["geoip:private"], "outboundTag": "block"}]},
    }
    os.makedirs(CONF_DIR, exist_ok=True)

    def undo(msg):
        if restored:
            move_json(CONF_DIR, CLOSED_DIR)
        for p in (BASE, EXITS, DROPIN):
            with contextlib.suppress(OSError):
                os.remove(p)
        subprocess.run(["systemctl", "daemon-reload"], capture_output=True)
        subprocess.run(["systemctl", "restart", "xray"], capture_output=True)
        die(msg + " Выход возвращён к прежнему конфигу.")

    if restored:
        # Выход уже был открыт и закрыт: возвращаем его конфиг вместе с пользователями.
        move_json(CLOSED_DIR, CONF_DIR)
        ib = load(BASE)["inbounds"][0]
        clients = ib["settings"]["clients"]
    else:
        save(BASE, base)
        save(EXITS, {"outbounds": []})
    test = subprocess.run([XRAY, "run", "-test", "-confdir", CONF_DIR], capture_output=True, text=True)
    if test.returncode != 0:
        out = (test.stdout + test.stderr).strip().splitlines()
        undo("новый конфиг не прошёл проверку:\n  " + "\n  ".join(out[-5:]) + "\n")
    os.makedirs(os.path.dirname(DROPIN), exist_ok=True)
    with open(DROPIN, "w") as f:
        f.write(f"[Service]\nExecStart=\nExecStart={XRAY} run -confdir {CONF_DIR}\n")
    subprocess.run(["systemctl", "daemon-reload"], capture_output=True)
    if not NO_RESTART:
        subprocess.run(["systemctl", "restart", "xray"], capture_output=True)
        time.sleep(1)
        if run_text("systemctl", "is-active", "xray") != "active":
            undo("Xray с новым конфигом не запустился.")
    # Порт 443 — всем: раньше он был открыт только мосту.
    subprocess.run(["ufw", "allow", f'{ib["port"]}/tcp'], capture_output=True)
    ensure_cron()
    with contextlib.suppress(OSError):
        shutil.copy(os.path.abspath(__file__), INSTALLED_TOOL)
        os.chmod(INSTALLED_TOOL, 0o755)
    return {"port": ib["port"], "users": [client_name(c) for c in clients], "restored": bool(restored)}


def move_json(src, dst):
    """Переносит конфиги (*.json) из src в dst; dst создаётся, старые файлы в нём заменяются."""
    os.makedirs(dst, exist_ok=True)
    for name in os.listdir(dst):
        path = os.path.join(dst, name)
        if name.endswith(".json") and os.path.abspath(path) not in (os.path.abspath(EXIT_CONF), os.path.abspath(USERS_META)):
            os.remove(path)
    keep = {os.path.abspath(EXIT_CONF), os.path.abspath(USERS_META)}  # на случай, если они лежат там же
    for name in os.listdir(src):
        path = os.path.join(src, name)
        if name.endswith(".json") and os.path.abspath(path) not in keep:
            shutil.move(path, os.path.join(dst, name))


def closed_config(exit_conf):
    """Конфиг, убранный exit close, если он от этого же выхода: тот же UUID моста и ключ Reality."""
    path = os.path.join(CLOSED_DIR, "00_base.json")
    if not os.path.exists(path):
        return False
    try:
        with open(path) as f:
            old = json.load(f)
        ib, cur = old["inbounds"][0], exit_conf["inbounds"][0]
        bridge = next(c for c in ib["settings"]["clients"] if client_name(c) == BRIDGE_USER)
        same = (bridge["id"] == cur["settings"]["clients"][0]["id"]
                and ib["streamSettings"]["realitySettings"]["privateKey"] == cur["streamSettings"]["realitySettings"]["privateKey"])
    except (OSError, ValueError, KeyError, IndexError, TypeError, StopIteration, SystemExit):
        return False
    return same


def exit_close():
    """Выход снова только для моста: Xray возвращается к config.json, порт закрывается для всех,
    кроме моста. Конфиг с пользователями убирается в CLOSED_DIR, повторный exit open вернёт его."""
    if not os.path.exists(BASE) or not os.path.exists(EXIT_CONF):
        die("это не выход, открытый для клиентов (exitctl exit open)")
    base = load(BASE)
    ib = base["inbounds"][0]
    if not any(client_name(c) == BRIDGE_USER for c in ib["settings"]["clients"]):
        die("это не выход, открытый для клиентов: в нём нет пользователя «bridge»")
    others = [client_name(c) for c in ib["settings"]["clients"] if client_name(c) != BRIDGE_USER]
    meta = load_meta()
    if not NO_RESTART and collect_traffic(meta):
        save_meta(meta)
    move_json(CONF_DIR, CLOSED_DIR)
    with contextlib.suppress(OSError):
        os.remove(DROPIN)
    subprocess.run(["systemctl", "daemon-reload"], capture_output=True)
    if not NO_RESTART:
        subprocess.run(["systemctl", "restart", "xray"], capture_output=True)
        time.sleep(1)
        if run_text("systemctl", "is-active", "xray") != "active":
            # Возвращаем открытый выход: лучше он, чем выход, который не работает совсем.
            move_json(CLOSED_DIR, CONF_DIR)
            os.makedirs(os.path.dirname(DROPIN), exist_ok=True)
            with open(DROPIN, "w") as f:
                f.write(f"[Service]\nExecStart=\nExecStart={XRAY} run -confdir {CONF_DIR}\n")
            subprocess.run(["systemctl", "daemon-reload"], capture_output=True)
            subprocess.run(["systemctl", "restart", "xray"], capture_output=True)
            die("Xray с конфигом выхода не запустился, выход оставлен открытым.")
    subprocess.run(["ufw", "delete", "allow", f'{ib["port"]}/tcp'], capture_output=True)
    with contextlib.suppress(OSError):
        os.remove(CRON_FILE)
    rules = run_text("ufw", "status") or ""
    bridge_rule = any(str(ib["port"]) in line and "ALLOW" in line and "Anywhere" not in line.split("ALLOW", 1)[1]
                      for line in rules.splitlines())
    return {"port": ib["port"], "closed_users": others, "bridge_rule": bridge_rule}



#!/usr/bin/env python3
"""exitctl — управление выходными нодами на мосту Xray.

  exitctl list [--json]            список выходов и текущий режим
  exitctl add <vless://...> [имя]  добавить выход
  exitctl remove <имя>             удалить выход
  exitctl use <имя>                весь трафик через один выход
  exitctl auto                     автовыбор самого быстрого живого выхода
  exitctl check [--json]           проверить доступность выходов (TCP)
  exitctl direct add <домен>       пускать домен напрямую с моста
  exitctl direct remove <домен>    убрать домен из списка «напрямую»
  exitctl direct list [--json]     список своих доменов «напрямую»
  exitctl direct builtin [add|remove <запись>] [--json]
                                   встроенные списки «напрямую»: geosite:, domain:, geoip:, IP/сеть
  exitctl direct country <код>     встроенные списки для страны моста (ru, by, kz...)
  exitctl sni check <домен> [--ip IP] [--tries N] [--json]
                                   проверить домен для SNI (код выхода 1 — не подходит)
  exitctl sni scan [--ip IP] [--role bridge|exit] [--top N] [--workers N] [--max-checks N] [--json]
                                   подобрать SNI в /24 сервера (код выхода 1 — ничего не найдено)
  exitctl user list [--host АДРЕС] [--json]        пользователи, трафик и ссылки
  exitctl user add <имя> [--host АДРЕС] [--json]   добавить пользователя
  exitctl user link <имя> [--host АДРЕС]           показать ссылку пользователя
  exitctl user remove <имя>                        удалить пользователя
  exitctl user limit <имя> [--days N | --until ДАТА | --no-expiry] [--traffic ГБ | --no-traffic] [--json]
                                                   срок доступа и лимит трафика
  exitctl user disable|enable <имя> [--json]       отключить или включить (ссылка не меняется)
  exitctl user reset <имя> [--json]                обнулить накопленный трафик пользователя
  exitctl user enforce [--json]                    учесть трафик и отключить вышедших за пределы (cron)
  exitctl status [--json]                          состояние сервера и Xray
  exitctl health [--json]                          проблемы сервера: Xray, выходы, сертификат SNI, исходящий трафик (код 1 — есть проблемы)
  exitctl exit open [--json]                       выход — ещё и для клиентов (на выходе; ссылка моста не меняется)
  exitctl exit close [--json]                      закрыть выход для клиентов: снова только мост (пользователи сохраняются до open)
  exitctl reach <адрес> <порт> [--json]            достаёт ли этот сервер до адреса (код 1 — нет)
  exitctl migrate export                           пользователи, ключи Reality, выходы и сайты напрямую (JSON)
  exitctl migrate import <файл> [--keys] [--json]  добавить их сюда; --keys заменяет ключи Reality
"""

def cert_report(domain):
    """Сертификат сайта, под который маскируется сервер: Reality показывает клиентам именно его.

    Если сайт сломался или сертификат истёк, соединения с сервером начинают выглядеть подозрительно,
    а часть клиентов перестаёт подключаться: SNI тогда надо менять.
    """
    rep = {"domain": domain, "ok": False, "days_left": None, "error": None}
    ips = resolve_ipv4(domain)
    if not ips:
        rep["error"] = "домен не резолвится"
        return rep
    res = probe_tls(domain, ips[0])
    if res["error"]:
        rep["error"] = "сайт не отвечает по TLS: " + res["error"]
    elif res["cert_error"]:
        rep["error"] = "сертификат не проходит проверку: " + res["cert_error"]
    elif res["version"] != "TLSv1.3":
        rep["error"] = f'сайт больше не отдаёт TLS 1.3 ({res["version"]})'
    else:
        rep["days_left"] = cert_details(res["cert"])["days_left"]
        rep["ok"] = True
    return rep


def health_report():
    """Что сломалось или скоро сломается: problems — уже не работает, warnings — стоит посмотреть."""
    st = status_report()
    rep = {"installed": st["installed"], "mode": st["mode"], "xray": st["xray"]["active"],
           "sni": None, "exits": None, "egress": st["egress"], "problems": [], "warnings": []}
    if not st["installed"]:
        return rep
    problems, warnings = rep["problems"], rep["warnings"]
    if not st["xray"]["active"]:
        problems.append("Xray не работает: клиенты не могут подключиться")
    blocked = [h for h, ok in st["egress"].items() if not ok]
    if not st["capabilities"].get(st["mode"]):
        problems.append("хостер ограничил исходящий трафик, для этой роли его не хватает: нет связи с "
                        + ", ".join(blocked))
    if st["sni"]:
        cert = rep["sni"] = cert_report(st["sni"])
        if not cert["ok"]:
            problems.append(f'сайт для SNI {st["sni"]}: {cert["error"]}')
        elif cert["days_left"] < SNI_CERT_MIN_DAYS:
            warnings.append(f'сертификат сайта для SNI {st["sni"]} истекает через {cert["days_left"]} дн.: '
                            "если владелец его не продлит, SNI придётся сменить")
    if st["mode"] == "bridge":
        rows = rep["exits"] = exits_health(load(EXITS, {"outbounds": []}))
        dead = [r["name"] for r in rows if not r["ok"]]
        if not rows:
            problems.append("выходов нет: открываются только сайты, которые мост пускает напрямую")
        elif len(dead) == len(rows):
            problems.append("мост не достаёт ни до одного выхода: " + ", ".join(dead))
        elif dead:
            warnings.append("недоступны выходы: " + ", ".join(dead) + "; трафик идёт через остальные")
        pinned = (find_rule(load(BASE), RULE_EXITS) or {}).get("outboundTag")
        if pinned and pinned[len(PREFIX):] in dead and len(dead) < len(rows):
            problems.append(f"весь трафик закреплён за выходом {pinned[len(PREFIX):]}, а он недоступен: "
                            "включите автовыбор или закрепите другой")
    return rep


